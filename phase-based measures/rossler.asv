%% ROSSLER Images

% Bidirectional coupling with equal coupling strengths x→y = y→x = 1.
x_labels = linspace(min_noise_x, max_noise_x, noise);
y_labels = linspace(min_noise_y, max_noise_y, noise);

% Number of colors in the colormap
nColors = 256;
customColormap = [ones(nColors, 1), linspace(0, 1, nColors)', linspace(0, 1, nColors)'];
% Create a new figure
figure;

% Subplot for V_x
subplot(1, 3, 1);  % 1 row, 3 columns, 1st subplot
imagesc(V_x_test);
title('Rossler dynamics, non-equal coupling = 2, V_x');
colorbar;
colormap(customColormap);
xticks(1:noise);
xticklabels(arrayfun(@num2str, x_labels, 'UniformOutput', false));
yticks(1:noise);
yticklabels(arrayfun(@num2str, y_labels, 'UniformOutput', false));

% Subplot for V_y
subplot(1, 3, 2);  % 1 row, 3 columns, 2nd subplot
imagesc(M_x_test);
title('Rossler dynamics, non-equal coupling = 1, M_x');
colorbar;
colormap(customColormap);
xticks(1:noise);
xticklabels(arrayfun(@num2str, x_labels, 'UniformOutput', false));
yticks(1:noise);
yticklabels(arrayfun(@num2str, y_labels, 'UniformOutput', false));

% Subplot for R_all
subplot(1, 3, 3);  % 1 row, 3 columns, 3rd subplot
imagesc(S_x_test);
title('Rossler dynamics, non-equal coupling, S_x');
colorbar;
colormap(customColormap);
xticks(1:noise);
xticklabels(arrayfun(@num2str, x_labels, 'UniformOutput', false));
yticks(1:noise);
yticklabels(arrayfun(@num2str, y_labels, 'UniformOutput', false));
