%% ROSSLER
% 
coupling_xy = 2;
coupling_yx = 1;
dt = 0.001;
At = 0.3;
N= 4096; 
npre =100000;
dim= 6;
max_noise_x = 2;
max_noise_y = 2;
min_noise_x = 0;
min_noise_y = 0;
noise = 20;

V_x_test_all = zeros(20,20,50);
M_x_test_all = zeros(20,20,50);
S_x_test_all = zeros(20,20,50);

for i = 1:50
    [V_x,V_y,M_x,S_x,R_all,V_s_x,M_s_x,S_s_x,R_all_s] = EA_Rossler_Main(1, coupling_xy,coupling_yx, dt, At, N, npre, ...
        dim, max_noise_x, max_noise_y, min_noise_x, min_noise_y, noise);
    
    for ix = 1:20
        for iy = 1:20
            if V_x(ix,iy) < min(V_s_x(ix,iy,1:19))
                V_x_test_all(ix,iy,i) = 1;
            end
    
            % Test M
            if M_x(ix,iy) < min(M_s_x(ix,iy,1:19))
                M_x_test_all(ix,iy,i) = 1;
            end
            
            
            % Test S
            if S_x(ix,iy) < min(S_s_x(ix,iy,1:19))
                S_x_test_all(ix,iy,i) = 1;
            end
    
        end
    end
    

end

